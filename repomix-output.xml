<file path="src/features/games/GamePlanningEngine.tsx">
import React, { useState, useEffect } from 'react';
import { 
  GripVertical, 
  CheckCircle2, 
  AlertCircle, 
  ArrowRight, 
  Clock,
  ClipboardList,
  Zap
} from 'lucide-react';
import { GameResults } from './GameResults';

interface GamePlanningEngineProps {
  scenario: any;
  onClose: () => void;
}

export const GamePlanningEngine = ({ scenario, onClose }: GamePlanningEngineProps) => {
  // Chargement des données configurées dans l'Admin
  const config = scenario?.config_json || {};
  const initialTasks = config.tasks || [];
  const incidents = config.incidents || [];
  
  // ÉTATS DE JEU
  const [todoList, setTodoList] = useState([...initialTasks]);
  const [completedCount, setCompletedCount] = useState(0);
  const [activeIncident, setActiveIncident] = useState<any>(null);
  const [scores, setScores] = useState({ security: 0, hygiene: 0, communication: 0 });
  const [showResults, setShowResults] = useState(false);

  /**
   * SURVEILLANCE DES INCIDENTS
   * Déclenche l'alerte si le nombre de tâches effectuées correspond au réglage admin
   */
  useEffect(() => {
    const incidentToTrigger = incidents.find((inc: any) => inc.triggerAfterSteps === completedCount);
    if (incidentToTrigger && !activeIncident) {
      setActiveIncident(incidentToTrigger);
    }
  }, [completedCount, incidents, activeIncident]);

  const handleTaskAction = (task: any) => {
    // Si un incident est en cours, on peut bloquer ou pénaliser (ici on progresse)
    setScores(prev => ({
      security: prev.security + (task.impact?.security || 0),
      hygiene: prev.hygiene + (task.impact?.hygiene || 0),
      communication: prev.communication + (task.impact?.communication || 0),
    }));

    setCompletedCount(prev => prev + 1);
    setTodoList(prev => prev.filter(t => t.id !== task.id));
  };

  const resolveIncident = () => {
    // Résoudre l'incident rapporte les points configurés
    setScores(prev => ({
      security: prev.security + (activeIncident.impact?.security || 0),
      hygiene: prev.hygiene + (activeIncident.impact?.hygiene || 0),
      communication: prev.communication + (activeIncident.impact?.communication || 0),
    }));
    setActiveIncident(null);
  };

  if (showResults) {
    return <GameResults scenario={scenario} finalScores={scores} onFinish={onClose} />;
  }

  return (
    <div className="w-full max-w-4xl mx-auto flex flex-col gap-8 animate-in fade-in duration-700 font-sans">
      
      {/* HUD : BARRE DE PROGRESSION ÉPURÉE */}
      <div className="flex justify-between items-center bg-white/10 backdrop-blur-xl p-6 rounded-[2.5rem] border border-white/20 shadow-2xl">
        <div className="flex items-center gap-4 text-white">
          <div className="bg-[#962588] p-3 rounded-2xl shadow-lg animate-pulse"><ClipboardList size={24}/></div>
          <div>
            <h2 className="font-black uppercase tracking-tighter text-lg leading-none">{scenario.title}</h2>
            <p className="text-[10px] font-bold opacity-60 uppercase tracking-widest mt-1">Gestion des priorités</p>
          </div>
        </div>
        <div className="bg-white/10 px-6 py-3 rounded-2xl text-white font-black text-sm flex items-center gap-3 border border-white/10">
          <Clock size={18} className="text-[#00aeb7]" /> 
          <span className="tabular-nums">{completedCount} / {initialTasks.length}</span>
        </div>
      </div>

      {/* OVERLAY D'INCIDENT CRITIQUE */}
      {activeIncident && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-6 bg-slate-900/90 backdrop-blur-md animate-in fade-in zoom-in duration-300">
          <div className="bg-white w-full max-w-lg rounded-[3.5rem] p-12 border-8 border-purple-100 shadow-2xl text-center space-y-8 relative overflow-hidden">
            <div className="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-purple-500 via-pink-500 to-purple-500 animate-gradient-x"></div>
            
            <div className="w-24 h-24 bg-purple-50 text-[#962588] rounded-full flex items-center justify-center mx-auto shadow-inner border-2 border-white">
              <Zap size={48} className="fill-current" />
            </div>

            <div className="space-y-2">
              <h3 className="text-3xl font-black text-slate-800 uppercase tracking-tighter italic">URGENCE : {activeIncident.label}</h3>
              <div className="bg-purple-50 px-4 py-1 rounded-full inline-block">
                <span className="text-[10px] font-black text-[#962588] uppercase tracking-widest">Incident imprévu</span>
              </div>
            </div>

            <p className="text-slate-500 font-medium leading-relaxed text-lg italic">
              "{activeIncident.description}"
            </p>

            <button 
              onClick={resolveIncident}
              className="w-full py-6 bg-[#962588] text-white rounded-[2rem] font-black uppercase tracking-widest text-sm shadow-xl hover:bg-[#7e1d72] hover:scale-105 transition-all flex items-center justify-center gap-3"
            >
              Intervenir immédiatement <ArrowRight size={20} />
            </button>
          </div>
        </div>
      )}

      {/* LISTE DES TÂCHES À EFFECTUER */}
      <div className="grid gap-4">
        {todoList.length > 0 ? (
          todoList.map((task, index) => (
            <div 
              key={task.id}
              className="bg-white p-8 rounded-[3rem] shadow-xl border border-slate-100 flex items-center gap-6 group hover:border-[#00aeb7] transition-all animate-in slide-in-from-bottom-4"
              style={{ animationDelay: `${index * 100}ms` }}
            >
              <div className="bg-slate-50 p-4 rounded-3xl text-slate-300 group-hover:text-[#00aeb7] transition-colors shadow-inner">
                <GripVertical size={24} />
              </div>
              
              <div className="flex-1">
                <h4 className="text-xl font-black text-slate-800 uppercase tracking-tighter leading-tight">{task.label}</h4>
                <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Action planifiée</p>
              </div>

              <button 
                onClick={() => handleTaskAction(task)}
                className="bg-slate-900 text-white px-10 py-5 rounded-2xl font-black uppercase tracking-widest text-xs hover:bg-[#00aeb7] transition-all shadow-lg flex items-center gap-2 border-b-4 border-black active:border-b-0 active:translate-y-1"
              >
                Valider <CheckCircle2 size={18} />
              </button>
            </div>
          ))
        ) : (
          <div className="bg-white p-20 rounded-[4rem] text-center space-y-8 shadow-2xl border-8 border-white animate-in zoom-in">
             <div className="w-32 h-32 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto shadow-inner border-2 border-white">
               <CheckCircle2 size={64} />
             </div>
             <div className="space-y-2">
               <h3 className="text-4xl font-black text-slate-800 uppercase tracking-tighter italic">Mission accomplie</h3>
               <p className="text-slate-400 font-medium text-lg">Le planning a été respecté malgré les imprévus.</p>
             </div>
             <button 
              onClick={() => setShowResults(true)}
              className="w-full max-w-sm mx-auto py-6 bg-[#00aeb7] text-white rounded-[2.5rem] font-black uppercase tracking-[0.2em] text-sm shadow-2xl hover:bg-[#008c93] hover:scale-105 transition-all flex items-center justify-center gap-4"
             >
               Générer mon bilan ELPI <ArrowRight size={20} />
             </button>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/features/games/GameResults.tsx">
import React, { useEffect, useState } from 'react';
import { supabase } from '../../lib/supabase';
import { useAuth } from '../auth/AuthContext';
import { Medal, AlertTriangle } from 'lucide-react';

export const GameResults = ({ scenario, finalScores, onFinish }: any) => {
  const { user } = useAuth();
  const [saving, setSaving] = useState(true);
  const [performance, setPerformance] = useState(0);
  const [dbError, setDbError] = useState<string | null>(null);

  useEffect(() => {
    const calculateAndSave = async () => {
      try {
        let maxPotential = 0;
        let minPotential = 0;
        const config = scenario.config_json || {};
        const mechanic = scenario.mechanic || 'dialogue';

        // CALCUL DE PERFORMANCE SELON LA MÉCANIQUE
        if (mechanic === '360') {
          // Pour le 360, le potentiel max est la somme de tous les points configurés
          const hotspots = config.hotspots || [];
          hotspots.forEach((h: any) => {
            maxPotential += (h.impact?.security || 0) + (h.impact?.hygiene || 0) + (h.impact?.communication || 0);
          });
          minPotential = 0;
        } else {
          // Logique classique pour les dialogues
          const steps = config.steps || [];
          steps.forEach((step: any) => {
            if (step.choices && step.choices.length > 0) {
              const impacts = step.choices.map((c: any) => 
                (c.impact?.communication || 0) + (c.impact?.security || 0) + (c.impact?.hygiene || 0)
              );
              maxPotential += Math.max(...impacts);
              minPotential += Math.min(...impacts);
            }
          });
        }

        const totalObtained = (finalScores.security || 0) + (finalScores.hygiene || 0) + (finalScores.communication || 0);
        const range = maxPotential - minPotential;
        const resultPercent = range > 0 ? ((totalObtained - minPotential) / range) * 100 : 100;
        
        setPerformance(resultPercent);

        // ENREGISTREMENT SQL
        if (user?.id) {
          const { error } = await supabase.from('game_scores').insert([{
            user_id: user.id,
            game_id: scenario.id,
            score: totalObtained,
            performance_percentage: resultPercent,
            score_security: finalScores.security || 0,
            score_hygiene: finalScores.hygiene || 0,
            score_communication: finalScores.communication || 0,
            completed_at: new Date().toISOString()
          }]);

          if (error) throw error;
        }
      } catch (err: any) {
        console.error("Erreur résultats:", err);
        setDbError(err.message);
      } finally {
        setSaving(false);
      }
    };
    calculateAndSave();
  }, [user, scenario, finalScores]);

  const getBadge = () => {
    if (performance >= 90) return { label: 'Expert', color: 'text-yellow-500', bg: 'bg-yellow-50' };
    if (performance >= 70) return { label: 'Confirmé', color: 'text-slate-400', bg: 'bg-slate-50' };
    return { label: 'Apprenti', color: 'text-orange-400', bg: 'bg-orange-50' };
  };

  const badge = getBadge();

  return (
    <div className="max-w-2xl w-full bg-white rounded-[3.5rem] p-10 md:p-16 shadow-2xl text-center animate-in zoom-in duration-500 border-4 border-white font-sans">
      {dbError ? (
        <div className="mb-8 p-4 bg-red-50 border-2 border-red-100 rounded-2xl text-red-600 text-sm font-bold flex items-center gap-3">
          <AlertTriangle /> Erreur : {dbError}
        </div>
      ) : (
        <div className={`w-24 h-24 ${badge.bg} ${badge.color} rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner border-2 border-white`}>
          <Medal size={48} />
        </div>
      )}
      
      <h2 className="text-3xl font-black text-slate-800 mb-2">Rang {badge.label}</h2>
      <p className="text-[#00aeb7] text-xs uppercase font-black tracking-widest mb-10">
        Précision pédagogique : {Math.round(performance)}%
      </p>

      <button 
        onClick={onFinish} 
        disabled={saving} 
        className="w-full py-5 bg-[#00aeb7] text-white rounded-[1.5rem] font-black hover:bg-[#008c93] shadow-xl transition-all flex items-center justify-center gap-3 uppercase text-sm tracking-widest disabled:opacity-50"
      >
        {saving ? 'Analyse des données...' : 'Valider mon badge'} 
      </button>
    </div>
  );
};
</file>

